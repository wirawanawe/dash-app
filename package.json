{
  "name": "dash-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "node scripts/init-db.js",
    "debug-db": "node debug-database.js",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop dash-app",
    "pm2:restart": "pm2 restart dash-app",
    "pm2:delete": "pm2 delete dash-app",
    "pm2:logs": "pm2 logs dash-app",
    "pm2:status": "pm2 status",
    "deploy": "npm run build && pm2 reload ecosystem.config.cjs --env production"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "jose": "^6.0.4",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mysql2": "^3.14.1",
    "next": "15.1.7",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
